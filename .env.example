# Optional settings for direct server runs; .env is NOT loaded automatically.
# Copy to .env, replace the placeholder token, then:
# node --env-file=.env src/server.mjs
# The launcher generates its own bridge credential and chooses a free port.
HOST=127.0.0.1
PORT=4143
GHCP_MODEL=gpt-6-astra
BRIDGE_API_KEY=replace-with-a-random-local-bridge-token
# COPILOT_HOME=~/.copilot
LOG_LEVEL=error
TURN_TIMEOUT_MS=300000
# Total manager request deadline, including queue wait; body reception is separate.
REQUEST_TIMEOUT_MS=360000
MAX_REQUESTS_PER_SESSION=8
MAX_REQUESTS=128
# Local SDK control-plane health, not an upstream inference guarantee.
SDK_READINESS_TIMEOUT_MS=2000
SDK_STARTUP_TIMEOUT_MS=30000
SDK_READINESS_INTERVAL_MS=15000
SDK_RECOVERY_BACKOFF_MS=5000
CLEANUP_TIMEOUT_MS=5000
PENDING_TOOL_WAIT_MS=10000
STATE_IDLE_TTL_MS=1800000
MAX_STATES=64
# Both limits default to 32 MiB; these are byte limits, not model token limits.
MAX_BODY_BYTES=33554432
MAX_REPLAY_BYTES=33554432
MAX_TOOL_RESULTS=32
