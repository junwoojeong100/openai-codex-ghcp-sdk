{
  "name": "openai-codex-ghcp-sdk",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Run OpenAI Codex with GitHub Copilot models through the GitHub Copilot SDK.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "bin": {
    "codex-ghcp": "bin/codex-ghcp",
    "codex-ghcp-status": "bin/codex-ghcp-status",
    "codex-ghcp-stop": "bin/codex-ghcp-stop",
    "ghcp-doctor": "bin/ghcp-doctor",
    "ghcp-models": "bin/ghcp-models"
  },
  "scripts": {
    "bridge": "node src/server.mjs",
    "doctor": "node src/doctor.mjs",
    "models": "node src/list-models.mjs",
    "test": "node --test test/*.test.mjs",
    "test:docs": "node --test test/documentation.test.mjs",
    "test:coverage": "mkdir -p coverage && node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include='src/**/*.mjs' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info test/*.test.mjs",
    "test:ci": "npm run test:coverage",
    "test:runtime": "node --test --test-concurrency=1 test/runtime/*.test.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.14",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@xterm/xterm": "6.0.0",
    "playwright": "1.63.0"
  }
}
