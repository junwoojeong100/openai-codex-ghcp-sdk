{
  "name": "openai-codex-ghcp-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Run OpenAI Codex with GitHub Copilot models through the GitHub Copilot SDK.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "bin": {
    "codex-ghcp": "bin/codex-ghcp",
    "codex-ghcp-status": "bin/codex-ghcp-status",
    "codex-ghcp-stop": "bin/codex-ghcp-stop",
    "ghcp-doctor": "bin/ghcp-doctor",
    "ghcp-models": "bin/ghcp-models"
  },
  "scripts": {
    "bridge": "node src/server.mjs",
    "doctor": "node src/doctor.mjs",
    "models": "node src/list-models.mjs",
    "test": "node --test test/*.test.mjs",
    "test:scenarios": "node scripts/native-coverage.mjs --design",
    "test:runner:prepare": "node scripts/e2e-native-v2.mjs --prepare",
    "test:runner:check": "node scripts/check-native-runner.mjs",
    "test:runner:runtime": "node scripts/check-native-runtime.mjs",
    "test:runner:drivers": "node scripts/check-native-drivers.mjs",
    "test:e2e:native-v2": "node scripts/e2e-native-v2.mjs",
    "test:e2e:native-coverage": "node scripts/native-coverage.mjs",
    "test:e2e:protocol": "node scripts/validate.mjs",
    "docs:scenarios": "node scripts/generate-native-docs.mjs",
    "docs:scenarios:check": "node scripts/generate-native-docs.mjs --check"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.14",
    "proper-lockfile": "4.1.2"
  }
}
